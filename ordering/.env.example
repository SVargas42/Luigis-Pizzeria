DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=luigis_app
DB_PASSWORD="YOUR_DATABASE_PASSWORD"
DB_NAME=luigis
HOST=127.0.0.1
PORT=3000
# Must be your actual HTTPS origin in production, without a path.
SITE_URL=http://127.0.0.1:3000
# Used only between Node and the localhost Python lifecycle service, not for website login.
ADMIN_USER=lifecycle_service
ADMIN_PASSWORD="YOUR_INTERNAL_SERVICE_PASSWORD"
LIFECYCLE_URL=http://127.0.0.1:8000
# Verified sending domain/address in Resend; required for registration, verification and recovery.
RESEND_API_KEY=""
ACCOUNT_MAIL_FROM="Luigi Accounts <accounts@your-domain.example>"
# Enable only behind a loopback reverse proxy that OVERWRITES X-Real-IP with the actual client IP.
TRUST_PROXY_LOOPBACK=0

# Enable after applying 004_stripe.sql and testing Stripe sandbox webhooks.
STRIPE_ENABLED=0
STRIPE_MODE=test
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Must match the Python lifecycle service. Fixed basis-points tax, not Stripe Tax.
TAX_BASIS_POINTS=0

# Pickup receipt email: provider-supplied SMTP settings, using STARTTLS.
SMTP_HOST=""
SMTP_PORT=587
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
